{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      /* TanStack Start ships its own nested copy of router-core, so the
         `server.handlers` augmentation it declares lands on a different type
         identity than the router-core the app resolves. Collapsing both onto
         the hoisted copy is what makes server routes (the generated MCP ones)
         typecheck. */
      "@tanstack/router-core": ["./node_modules/@tanstack/router-core"],
      "@tanstack/router-core/*": ["./node_modules/@tanstack/router-core/*"]
    }
  }
}
